{
  "name": "classtrack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cap:build:android": "pnpm cap:sync:android && ./android/gradlew -p android assembleDebug && pnpm android:check-assets && pnpm webview:check-css",
    "cap:install:android": "bash scripts/install-android.sh",
    "android:check-assets": "node scripts/check-android-assets.js",
    "test:android-assets": "node --test scripts/check-android-assets.test.js",
    "webview:check-css": "node scripts/check-webview-css-fallback.js",
    "test:webview-css": "node --test scripts/check-webview-css-fallback.test.js",
    "cap:open:android": "cap open android",
    "cap:sync:android": "pnpm build && cap sync android",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css}": "prettier --write"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/react": "^7.22.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "immer": "^11.1.8",
    "isbot": "^5.1.36",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-router": "7.15.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.3",
    "vitest": "5.0.1"
  }
}
